---------------------------------------------------------
-- CREACIÓN DE TABLAS: clientes, productos y ventas.
-- DDL – Estructura de tablas
---------------------------------------------------------

CREATE DATABASE tienda_retail;

-- creamos la tabla clientes
DROP TABLE IF EXISTS clientes;
CREATE TABLE clientes (
	id_cliente SERIAL PRIMARY KEY,
	nombre VARCHAR(100) NOT NULL,
	apellido VARCHAR(100) NOT NULL,
	edad INT CHECK (edad >= 18) NOT NULL,
	dni INT NOT NULL UNIQUE,
	ciudad VARCHAR(100) NOT NULL,
	mail VARCHAR(100) NOT NULL UNIQUE
);

-- creamos la tabla productos
DROP TABLE IF EXISTS productos;
CREATE TABLE productos (
	id_producto SERIAL PRIMARY KEY,
	nombre_producto VARCHAR(100) NOT NULL,
	precio_producto DECIMAL (10,2) CHECK (precio_producto > 0) -- checkeamos que el precio sea mayor que cero.
);

-- creamos la tabla ventas
DROP TABLE IF EXISTS ventas;
CREATE TABLE ventas (
	id_venta SERIAL PRIMARY KEY,
	fecha_compra DATE DEFAULT CURRENT_DATE,
	cliente_id INT REFERENCES clientes(id_cliente), -- Creamos una FK para "conectar" con la tabla clientes.
	producto_vendido INT REFERENCES productos(id_producto), -- Creamos una FK para "conectar" con la tabla productos
	cantidad INT CHECK (cantidad > 0)  -- checkeamos que la cantidad sea mayor que 0.
);

